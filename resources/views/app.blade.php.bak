                                    <div class="pt-3 border-t border-slate-800 flex justify-between items-center text-xs">
                                        <span class="text-slate-500 font-semibold">${c.orders_count || 0} Orders</span>
                                        <button onclick="openCustomerProfileModal(${c.id})" class="text-cyan-400 font-bold hover:underline">View Timeline &rarr;</button>
                                    </div>
