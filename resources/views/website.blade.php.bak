<!DOCTYPE html>
<html lang="am" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>ሜሽ የፅዳት አገልግሎት | Mesh Cleaning Solution - World-Class 3D Cleaning</title>
    <meta name="description" content="ሜሽ የፅዳት አገልግሎት (Mesh Cleaning Solution) - በአዲስ አበባ የሶፋ፣ ምንጣፍ፣ ፍራሽ፣ መስታወት እና ጥልቅ የቤትና ቢሮ ፅዳት በሆስፒታል ደረጃ ስቲም ቴክኖሎጂ።">
    <meta name="theme-color" content="#0F172A">
    
    <!-- PWA Manifest & Icons -->
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/assets/icon-192.png">
    <link rel="icon" type="image/jpeg" href="/logo.jpg">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="ሜሽ ክሊኒንግ">

    <!-- OpenGraph Social Preview -->
    <meta property="og:title" content="ሜሽ የፅዳት አገልግሎት | Mesh Cleaning Solution">
    <meta property="og:description" content="የሆስፒታል ደረጃ የሶፋ፣ ምንጣፍ፣ ፍራሽና የመስታወት ጥልቅ እጥበት በአዲስ አበባ።">
    <meta property="og:image" content="/logo.jpg">
    <meta property="og:type" content="website">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        mesh: {
                            navy: '#0B1120',
                            card: '#131D31',
                            surface: '#1E293B',
                            cyan: '#06B6D4',
                            blue: '#0284C7',
                            teal: '#0D9488',
                            emerald: '#10B981',
                            accent: '#38BDF8',
                        }
                    },
                    boxShadow: {
                        '3d-cyan': '0 20px 50px -10px rgba(6, 182, 212, 0.3)',
                        '3d-blue': '0 20px 50px -10px rgba(2, 132, 199, 0.3)',
                        '3d-emerald': '0 20px 50px -10px rgba(16, 185, 129, 0.3)',
                        'glow': '0 0 30px rgba(56, 189, 248, 0.25)',
                    },
                    animation: {
                        'float-slow': 'float 6s ease-in-out infinite',
                        'float-reverse': 'floatRev 7s ease-in-out infinite',
                        'pulse-glow': 'pulseGlow 3s ease-in-out infinite',
                        'shimmer': 'shimmer 2.5s linear infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0px) rotate(0deg)' },
                            '50%': { transform: 'translateY(-15px) rotate(1.5deg)' },
                        },
                        floatRev: {
                            '0%, 100%': { transform: 'translateY(0px) rotate(0deg)' },
                            '50%': { transform: 'translateY(15px) rotate(-1.5deg)' },
                        },
                        pulseGlow: {
                            '0%, 100%': { opacity: '0.4', filter: 'blur(20px)' },
                            '50%': { opacity: '0.8', filter: 'blur(30px)' },
                        },
                        shimmer: {
                            '0%': { backgroundPosition: '-200% 0' },
                            '100%': { backgroundPosition: '200% 0' },
                        }
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Translations & Offline Engine -->
    <script src="/js/meash-i18n.js"></script>
    <script src="/js/meash-offline.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&family=Noto+Sans+Ethiopic:wght@400;600;700;800;900&display=swap');
        body {
            font-family: 'Noto Sans Ethiopic', 'Plus Jakarta Sans', sans-serif;
            background-color: #070B14;
            color: #F8FAFC;
            overflow-x: hidden;
        }
        /* 3D Canvas Background */
        #clean-3d-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 0;
        }
        /* Glassmorphism Styles */
        .glass-panel {
            background: rgba(19, 29, 49, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .glass-card-interactive {
            background: linear-gradient(135deg, rgba(30, 41, 59, 0.7) 0%, rgba(15, 23, 42, 0.85) 100%);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(56, 189, 248, 0.15);
            transition: transform 0.3s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.3s ease, border-color 0.3s ease;
            transform-style: preserve-3d;
        }
        .glass-card-interactive:hover {
            border-color: rgba(56, 189, 248, 0.5);
            box-shadow: 0 20px 40px -15px rgba(6, 182, 212, 0.35);
        }
        /* 3D Before/After Comparison Container */
        .before-after-wrapper {
            position: relative;
            overflow: hidden;
            border-radius: 1.5rem;
            user-select: none;
            touch-action: pan-y;
        }
        .after-image-layer {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            overflow: hidden;
            width: 50%;
            border-right: 3px solid #38BDF8;
        }
        .slider-handle {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 44px;
            height: 44px;
            background: #0284C7;
            border: 3px solid #FFFFFF;
            border-radius: 9999px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 25px rgba(56, 189, 248, 0.8);
            cursor: ew-resize;
            z-index: 20;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #070B14; }
        ::-webkit-scrollbar-thumb { background: #1E293B; border-radius: 4px; border: 1px solid rgba(56, 189, 248, 0.2); }
        ::-webkit-scrollbar-thumb:hover { background: #0284C7; }
    </style>
</head>
<body class="selection:bg-cyan-500 selection:text-white">

    <!-- 3D INTERACTIVE PARTICLE & STEAM CANVAS -->
    <canvas id="clean-3d-canvas"></canvas>

    <!-- PWA INSTALL BANNER (Native prompt trigger) -->
    <div id="pwa-install-banner" class="hidden fixed bottom-6 left-4 right-4 sm:left-auto sm:right-6 sm:w-96 z-50 p-4 rounded-2xl glass-panel border border-cyan-500/40 shadow-2xl shadow-cyan-500/20 animate-bounce">
        <div class="flex items-center gap-3">
            <img src="/logo.jpg" alt="Mesh Logo" class="w-12 h-12 rounded-xl object-cover border border-cyan-400/50 shadow-md shrink-0">
            <div class="flex-1 min-w-0">
                <h4 class="text-xs font-black text-white truncate">ሜሽ የፅዳት መተግበሪያ</h4>
                <p class="text-[11px] text-slate-300">ስልክዎ ላይ በቀጥታ በመጫን ፈጣን ፅዳት ይዘዙ!</p>
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
                <button onclick="triggerPwaInstall()" class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-extrabold text-xs shadow-md shadow-cyan-500/30 hover:scale-105 active:scale-95 transition-all">ጫን (Install)</button>
                <button onclick="dismissPwaBanner()" class="text-slate-400 hover:text-white p-1 text-base">&times;</button>
            </div>
        </div>
    </div>

    <!-- TOP ANNOUNCEMENT BAR -->
    <div class="relative z-30 bg-gradient-to-r from-cyan-900/90 via-blue-900/90 to-slate-900/90 backdrop-blur-md border-b border-cyan-500/20 px-4 py-2 text-xs font-medium text-white shadow-sm">
        <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
            <div class="flex items-center gap-2">
                <span class="flex h-2 w-2 relative">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
                </span>
                <span class="font-bold tracking-tight">✨ ሜሽ የፅዳት አገልግሎት - በአዲስ አበባ የላቀ የ 3D ስቲም ቴክኖሎጂ</span>
            </div>
            <div class="flex items-center gap-4 text-[11px]">
                <a href="tel:0911000002" class="flex items-center gap-1.5 font-bold hover:text-cyan-300 transition-colors">
                    <i data-lucide="phone" class="w-3.5 h-3.5 text-cyan-400"></i>
                    <span>ሪሴፕሽን: <strong>0911000002 / 0911000001</strong></span>
                </a>
                <!-- Language Switcher -->
                <div class="flex items-center bg-black/40 rounded-lg p-0.5 border border-white/20">
                    <button onclick="toggleLang('am')" id="top-btn-am" class="px-2 py-0.5 rounded font-extrabold text-white bg-cyan-600 transition-all">አማ</button>
                    <button onclick="toggleLang('en')" id="top-btn-en" class="px-2 py-0.5 rounded font-bold text-slate-400 hover:text-white transition-all">EN</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN NAVBAR (3D Glassmorphism) -->
    <header class="sticky top-0 z-40 backdrop-blur-2xl bg-slate-950/80 border-b border-white/10 transition-all">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Brand Logo -->
            <a href="/" class="flex items-center gap-3.5 group">
                <div class="relative">
                    <div class="absolute -inset-1 bg-gradient-to-r from-cyan-500 to-blue-600 rounded-2xl blur-sm opacity-70 group-hover:opacity-100 transition duration-300"></div>
                    <img src="/logo.jpg" alt="Mesh Cleaning Solution Logo" class="relative w-12 h-12 rounded-xl object-cover border border-cyan-400/40 shadow-lg shadow-cyan-500/20 group-hover:scale-105 transition-transform duration-300">
                </div>
                <div>
                    <h1 class="text-xl sm:text-2xl font-black tracking-tight bg-gradient-to-r from-white via-cyan-100 to-cyan-400 bg-clip-text text-transparent flex items-center gap-2">
                        ሜሽ
                        <span class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full bg-cyan-950 text-cyan-300 border border-cyan-800">MESH 3D</span>
                    </h1>
                    <p class="text-[10px] font-bold tracking-wider text-cyan-400 uppercase">Cleaning Solution</p>
                </div>
            </a>

            <!-- Navigation Links -->
            <nav class="hidden lg:flex items-center gap-7 text-sm font-semibold text-slate-300">
                <a href="#services" class="hover:text-cyan-400 transition-colors flex items-center gap-1.5"><i data-lucide="sparkles" class="w-4 h-4 text-cyan-400"></i><span id="nav-svc">አገልግሎቶች</span></a>
                <a href="#comparison" class="hover:text-cyan-400 transition-colors flex items-center gap-1.5"><i data-lucide="layers" class="w-4 h-4 text-cyan-400"></i><span id="nav-compare">3D ውጤት (Before/After)</span></a>
                <a href="#calculator" class="hover:text-cyan-400 transition-colors flex items-center gap-1.5"><i data-lucide="calculator" class="w-4 h-4 text-cyan-400"></i><span id="nav-calc">ዋጋ አስላ</span></a>
                <a href="#track" class="hover:text-cyan-400 transition-colors flex items-center gap-1.5"><i data-lucide="navigation" class="w-4 h-4 text-cyan-400"></i><span id="nav-track">ትዕዛዝ ተከታተል</span></a>
                <a href="#sms-test-section" class="hover:text-cyan-400 transition-colors flex items-center gap-1.5"><i data-lucide="message-square" class="w-4 h-4 text-cyan-400"></i><span>SMS ሞክር</span></a>
            </nav>

            <!-- Action Buttons -->
            <div class="flex items-center gap-2.5">
                <!-- Real Device Notifications Test Button -->
                <button onclick="requestPushNotification()" class="p-2 sm:px-3 sm:py-2 text-xs font-semibold rounded-xl bg-slate-900 hover:bg-slate-800 text-cyan-400 border border-slate-700/80 transition-all flex items-center gap-1.5" title="ማሳወቂያዎችን ፍቀድና ሞክር (Test Notifications)">
                    <i data-lucide="bell" class="w-4 h-4 text-cyan-400"></i>
                    <span class="hidden md:inline text-[11px]">ማሳወቂያ</span>
                </button>

                <!-- Telegram Direct Bot Link -->
                <a href="https://t.me/meash_cleaning_solution_bot" target="_blank" class="hidden sm:inline-flex items-center gap-2 px-3.5 py-2 text-xs font-bold rounded-xl bg-sky-500/10 hover:bg-sky-500/20 text-sky-400 border border-sky-500/30 transition-all">
                    <i data-lucide="send" class="w-3.5 h-3.5"></i>
                    <span class="hidden md:inline">@meash_cleaning_solution_bot</span>
                    <span class="md:hidden">ቦት</span>
                </a>

                <!-- Staff Login -->
                <a href="/app" class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-semibold rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-700 transition-all">
                    <i data-lucide="lock" class="w-3.5 h-3.5 text-cyan-400"></i>
                    <span class="hidden sm:inline">ሰራተኛ</span>
                </a>

                <!-- Instant Book CTA Button -->
                <a href="#book" class="inline-flex items-center gap-2 px-5 py-2.5 text-xs sm:text-sm font-extrabold rounded-xl bg-gradient-to-r from-cyan-500 via-blue-600 to-cyan-500 hover:from-cyan-400 hover:to-blue-500 text-white shadow-lg shadow-cyan-500/30 hover:shadow-cyan-500/50 transition-all transform hover:-translate-y-0.5">
                    <i data-lucide="calendar" class="w-4 h-4"></i>
                    <span id="nav-cta-book">ቦታ ያስይዙ</span>
                </a>
            </div>
        </div>
    </header>

    <!-- HERO SECTION (3D Futuristic Cleaning Experience) -->
    <section class="relative pt-12 pb-24 lg:pt-20 lg:pb-32 overflow-hidden z-10">
        <!-- Glow Orbs -->
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-gradient-to-tr from-cyan-600/20 via-blue-600/15 to-emerald-500/10 rounded-full blur-[100px] pointer-events-none animate-pulse-glow"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                <!-- Left Column: Copy & CTAs -->
                <div class="lg:col-span-7 text-center lg:text-left">
                    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass-panel border border-cyan-500/30 text-cyan-300 text-xs font-bold mb-6 shadow-sm">
                        <i data-lucide="sparkles" class="w-4 h-4 text-cyan-400 animate-spin" style="animation-duration: 6s;"></i>
                        <span>የአዲስ አበባ ፕሪሚየም የ 3D ስቲም ፅዳት ቴክኖሎጂ</span>
                    </div>

                    <h2 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-white leading-[1.1] mb-6">
                        ጥልቅ ፅዳት። <br>
                        <span class="bg-gradient-to-r from-cyan-400 via-teal-300 to-emerald-400 bg-clip-text text-transparent">አዲስ የህይወት እስትንፋስ።</span>
                    </h2>

                    <p class="text-base sm:text-lg text-slate-300 leading-relaxed mb-8 max-w-2xl mx-auto lg:mx-0 font-normal">
                        የሶፋ፣ ምንጣፍ፣ ፍራሽ እና መስታወት ንፅህናን በሆስፒታል ደረጃ ከፍተኛ ሙቀት ባለው ስቲም (Steam Extraction) እናቀርባለን። 99.9% ጀርሞችንና አቧራን አጥፍተን በ 45 ደቂቃ ውስጥ እንዲደርቅ እናደርጋለን።
                    </p>

                    <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-10">
                        <a href="#book" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-cyan-500 via-blue-600 to-cyan-500 hover:from-cyan-400 hover:to-blue-500 text-white font-extrabold text-base shadow-3d-cyan hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-3">
                            <i data-lucide="calendar" class="w-5 h-5"></i>
                            <span>በ 1 ደቂቃ ውስጥ ይዘዙ (Book Now)</span>
                        </a>
                        <a href="#comparison" class="w-full sm:w-auto px-7 py-4 rounded-2xl glass-panel hover:bg-slate-800 text-slate-200 font-bold text-base border border-slate-700 transition-all flex items-center justify-center gap-3">
                            <i data-lucide="eye" class="w-5 h-5 text-cyan-400"></i>
                            <span>3D ውጤቱን እይ (Before & After)</span>
                        </a>
                    </div>

                    <!-- Live Metrics Strip -->
                    <div class="grid grid-cols-3 gap-4 pt-8 border-t border-slate-800/80 max-w-lg mx-auto lg:mx-0">
                        <div class="p-3 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
                            <span class="text-2xl sm:text-3xl font-black text-cyan-400 block">99.9%</span>
                            <span class="text-[11px] text-slate-400 font-medium">ጀርም እና አቧራ ማስወገድ</span>
                        </div>
                        <div class="p-3 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
                            <span class="text-2xl sm:text-3xl font-black text-emerald-400 block">45 ደቂቃ</span>
                            <span class="text-[11px] text-slate-400 font-medium">ፈጣን ማድረቂያ ቴክኖሎጂ</span>
                        </div>
                        <div class="p-3 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
                            <span class="text-2xl sm:text-3xl font-black text-blue-400 block">10</span>
                            <span class="text-[11px] text-slate-400 font-medium">ክፍለ ከተሞች ሙሉ ሽፋን</span>
                        </div>
                    </div>
                </div>

                <!-- Right Column: 3D Interactive Floating Visual Card -->
                <div class="lg:col-span-5 relative">
                    <div class="relative mx-auto max-w-md">
                        <!-- Background Glow Accent -->
                        <div class="absolute -inset-4 bg-gradient-to-tr from-cyan-500/30 to-blue-600/30 rounded-3xl blur-2xl opacity-60 animate-pulse-glow"></div>

                        <!-- 3D Card Stack -->
                        <div class="relative rounded-3xl glass-card-interactive p-6 border border-cyan-500/30 shadow-2xl animate-float-slow">
                            <!-- Card Header -->
                            <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-5">
                                <div class="flex items-center gap-3">
                                    <img src="/logo.jpg" alt="Mesh" class="w-11 h-11 rounded-xl object-cover border border-cyan-400 shadow-md">
                                    <div>
                                        <h3 class="text-sm font-extrabold text-white">ሜሽ ጥልቅ ስቲም እጥበት</h3>
                                        <p class="text-[10px] text-cyan-400 font-semibold">Hospital Grade Deep Sanitization</p>
                                    </div>
                                </div>
                                <span class="px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-300 font-bold text-[10px] border border-emerald-500/40">● ኦንላይን ክፍት</span>
                            </div>

                            <!-- Showcase Simulation Media / Graphic -->
                            <div class="relative rounded-2xl overflow-hidden bg-slate-950 border border-slate-800 mb-5 p-5 text-center">
                                <div class="w-20 h-20 rounded-2xl bg-gradient-to-tr from-cyan-500 to-blue-600 mx-auto flex items-center justify-center text-white mb-3 shadow-lg shadow-cyan-500/30">
                                    <i data-lucide="sparkles" class="w-10 h-10"></i>
                                </div>
                                <h4 class="text-base font-extrabold text-white mb-1">የሶፋ እና የምንጣፍ 3D ስቲም እጥበት</h4>
                                <p class="text-xs text-slate-400">በእድፍ፣ በአቧራ እና በጀርም የተያዙ ጨርቆችን ወደ አዲስነት እንቀይራለን።</p>
                                <div class="mt-4 flex items-center justify-center gap-2">
