    <!-- JAVASCRIPT: 3D Canvas, Before/After Slider, Price Calculator, PWA, Notifications, SMS Test -->
    <script>
        // 1. 3D Interactive Particle & Steam Clean Canvas Engine
        (function init3DParticleCanvas() {
            const canvas = document.getElementById('clean-3d-canvas');
            const ctx = canvas.getContext('2d');
            let w, h;
            let particles = [];
            const particleCount = 45;
            let mouse = { x: -1000, y: -1000, radius: 140 };

            function resize() {
                w = canvas.width = window.innerWidth;
                h = canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            window.addEventListener('mousemove', (e) => {
                mouse.x = e.clientX;
                mouse.y = e.clientY;
            });
            window.addEventListener('mouseleave', () => {
                mouse.x = -1000;
                mouse.y = -1000;
            });

            class Particle {
                constructor() {
                    this.reset();
                }
                reset() {
                    this.x = Math.random() * w;
                    this.y = Math.random() * h;
                    this.vx = (Math.random() - 0.5) * 0.8;
                    this.vy = -(Math.random() * 1.2 + 0.3); // floats upward like clean steam
                    this.radius = Math.random() * 3 + 1.2;
                    this.baseAlpha = Math.random() * 0.4 + 0.15;
                    this.alpha = this.baseAlpha;
                    this.color = Math.random() > 0.4 ? '6, 182, 212' : (Math.random() > 0.5 ? '56, 189, 248' : '16, 185, 129');
                }
                update() {
                    this.x += this.vx;
                    this.y += this.vy;

                    // Mouse interaction (bubbles/steam avoid or react to cursor)
                    const dx = this.x - mouse.x;
                    const dy = this.y - mouse.y;
                    const dist = Math.sqrt(dx * dx + dy * dy);
                    if (dist < mouse.radius) {
                        const force = (mouse.radius - dist) / mouse.radius;
                        this.x += (dx / dist) * force * 5;
                        this.y += (dy / dist) * force * 5;
                        this.alpha = Math.min(0.9, this.baseAlpha + 0.4);
                    } else {
                        this.alpha = this.baseAlpha;
                    }

                    if (this.y < -10) this.reset();
                    if (this.x < -10 || this.x > w + 10) this.x = Math.random() * w;
                }
                draw() {
                    ctx.save();
                    ctx.beginPath();
                    ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(${this.color}, ${this.alpha})`;
                    ctx.shadowBlur = 12;
                    ctx.shadowColor = `rgba(${this.color}, 0.8)`;
                    ctx.fill();
                    ctx.restore();
                }
            }

            for (let i = 0; i < particleCount; i++) {
                particles.push(new Particle());
            }

            function animate() {
                ctx.clearRect(0, 0, w, h);
                particles.forEach(p => {
                    p.update();
                    p.draw();
                });
                requestAnimationFrame(animate);
            }
            animate();
        })();

        // 2. 3D Interactive Before / After Slider Engine
        (function initBeforeAfterSlider() {
            const container = document.getElementById('ba-container');
            const afterLayer = document.getElementById('ba-after-layer');
            const handle = document.getElementById('ba-handle');
            let isDragging = false;

            function updateSlider(x) {
                const rect = container.getBoundingClientRect();
                let pos = (x - rect.left) / rect.width;
                pos = Math.max(0.05, Math.min(0.95, pos));
                const pct = pos * 100;
                afterLayer.style.width = pct + '%';
                handle.style.left = pct + '%';
            }

            handle.addEventListener('mousedown', () => isDragging = true);
            window.addEventListener('mouseup', () => isDragging = false);
            window.addEventListener('mousemove', (e) => {
                if (!isDragging) return;
                updateSlider(e.clientX);
            });

            // Touch events for mobile phones
            handle.addEventListener('touchstart', () => isDragging = true);
            window.addEventListener('touchend', () => isDragging = false);
            window.addEventListener('touchmove', (e) => {
                if (!isDragging || !e.touches[0]) return;
                updateSlider(e.touches[0].clientX);
            });

            container.addEventListener('click', (e) => {
                updateSlider(e.clientX);
            });
        })();

        // 3. 3D Perspective Tilt on Card Hover
        function handleTilt(e, card) {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            const rotateX = ((y - centerY) / centerY) * -8;
            const rotateY = ((x - centerX) / centerX) * 8;

            card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
        }
        function resetTilt(card) {
            card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
        }

        // 4. Interactive Live Cost Estimator
        function calculatePrice() {
            const select = document.getElementById('calc-service');
            const opt = select.options[select.selectedIndex];
            const price = parseFloat(opt.getAttribute('data-price'));
            const unit = opt.getAttribute('data-unit');
            const qty = parseInt(document.getElementById('calc-range').value);

            document.getElementById('calc-unit-label').innerText = `2. የ${unit} ብዛት (Quantity)`;
            document.getElementById('calc-qty-badge').innerText = qty;

            const total = price * qty;
            document.getElementById('calc-total-display').innerText = `${total.toLocaleString()} ብር`;
            document.getElementById('calc-summary-desc').innerText = `${qty} ${unit} x ${price} ብር = ${total.toLocaleString()} ብር`;
        }

        function updateRangeValue(val) {
            document.getElementById('calc-qty-badge').innerText = val;
            calculatePrice();
        }

        function bookCalculatedPrice() {
            const select = document.getElementById('calc-service');
            const svcCode = select.value;
            const qty = parseInt(document.getElementById('calc-range').value);

            selectServiceForBooking(svcCode);
            wizardQty = qty;
            document.getElementById('wizard-qty').innerText = qty;
            updateWizardTotal();

            document.getElementById('book').scrollIntoView({ behavior: 'smooth' });
        }

        function quickBookSvc(code, price, unit) {
            selectServiceForBooking(code);
            document.getElementById('book').scrollIntoView({ behavior: 'smooth' });
        }

        // 5. Booking Wizard State & Logic
        const svcMeta = {
            sofa: { name: 'የሶፋ ጥልቅ እጥበት', price: 350, unit: 'መቀመጫ (Seats)' },
            carpet: { name: 'የምንጣፍ ማጠብና ስቲም', price: 80, unit: 'ካሬ ሜትር (Sqm)' },
            mattress: { name: 'የፍራሽ ሳኒታይዜሽን', price: 600, unit: 'ፍራሽ (Mattress)' },
            glass: { name: 'የመስታወት ፅዳት', price: 70, unit: 'ካሬ ሜትር (Sqm)' },
            residential: { name: 'የመኖሪያ ቤት አጠቃላይ ፅዳት', price: 2500, unit: 'ቤት (Home)' },
            commercial: { name: 'የድርጅት እና ቢሮ ፅዳት', price: 5000, unit: 'ተቋም (Commercial)' },
        };
        let selectedSvc = 'sofa';
        let wizardQty = 5;

        function selectServiceForBooking(code) {
            selectedSvc = code;
            wizardQty = code === 'carpet' ? 12 : (code === 'sofa' ? 5 : 1);
            document.getElementById('wizard-qty').innerText = wizardQty;
            document.getElementById('wizard-selected-svc-title').innerText = svcMeta[code].name;
            document.getElementById('wizard-unit-desc').innerText = svcMeta[code].unit;

            document.querySelectorAll('.svc-select-btn').forEach(btn => {
                if (btn.getAttribute('data-svc') === code) {
                    btn.classList.add('border-cyan-500', 'bg-cyan-950/40');
                    btn.classList.remove('border-slate-700', 'bg-slate-900');
                } else {
                    btn.classList.remove('border-cyan-500', 'bg-cyan-950/40');
                    btn.classList.add('border-slate-700', 'bg-slate-900');
                }
            });
            updateWizardTotal();
        }

        function changeWizardQty(delta) {
            wizardQty = Math.max(1, wizardQty + delta);
            document.getElementById('wizard-qty').innerText = wizardQty;
            updateWizardTotal();
        }

        function updateWizardTotal() {
            const price = svcMeta[selectedSvc].price;
            const total = wizardQty * price;
            document.getElementById('wizard-total-preview').innerText = `${total.toLocaleString()}.00 ብር`;
        }

        function showWizardStep(step) {
            document.querySelectorAll('.wizard-step').forEach(el => el.classList.add('hidden'));
            document.getElementById(`step-${step}`).classList.remove('hidden');
            document.getElementById('wizard-step-badge').innerText = step;
            document.getElementById('current-step-num').innerText = step;
            const titles = {
                1: 'አገልግሎት ይምረጡ',
                2: 'የፅዳት አድራሻ በአዲስ አበባ',
                3: 'የቀጠሮ ቀን እና ሰዓት',
                4: 'የእርስዎ መረጃ እና ማረጋገጫ'
            };
            document.getElementById('wizard-step-title').innerText = titles[step];
        }

        function nextWizardStep(step) {
            showWizardStep(step);
        }
        function prevWizardStep(step) {
            showWizardStep(step);
        }

        // 6. Live GPS Location Detection with Smart Accuracy Indicator
        function detectWebGpsLocation() {
            const btn = document.getElementById('btn-web-gps');
            const txt = document.getElementById('btn-web-gps-txt');
            if (!navigator.geolocation) {
                alert('የእርስዎ ብሮውዘር ጂፒኤስ (Geolocation) አይደግፍም። እባክዎ አድራሻዎን ከታች ይጻፉ።');
                return;
            }
            txt.innerText = 'በመፈለግ ላይ...';
            navigator.geolocation.getCurrentPosition(
                (pos) => {
                    const lat = pos.coords.latitude;
                    const lng = pos.coords.longitude;
                    const acc = Math.round(pos.coords.accuracy || 0);
                    document.getElementById('book-latitude').value = lat;
                    document.getElementById('book-longitude').value = lng;
                    const feedback = document.getElementById('web-gps-feedback');
                    feedback.classList.remove('hidden');

                    if (acc > 1000) {
                        feedback.className = 'mt-2.5 p-2.5 rounded-xl bg-amber-950/80 border border-amber-500/40 text-amber-200 text-xs flex items-center justify-between shadow-sm';
                        document.getElementById('web-gps-label').innerHTML = `⚠️ በኮምፒውተር/IP የተገመተ መገኛ (±${(acc/1000).toFixed(1)}km): እባክዎ ክፍለ ከተማዎን ይምረጡ`;
                    } else {
                        feedback.className = 'mt-2.5 p-2.5 rounded-xl bg-emerald-950/80 border border-emerald-500/40 text-emerald-200 text-xs flex items-center justify-between shadow-sm';
                        document.getElementById('web-gps-label').innerHTML = `📍 ትክክለኛ የሞባይል GPS ተመዝግቧል (±${acc}m)`;
                    }

                    document.getElementById('web-gps-link').href = `https://www.google.com/maps?q=${lat},${lng}`;
                    txt.innerText = '✅ ተገኝቷል (Location Set)';
                    lucide.createIcons();
                },
                (err) => {
                    txt.innerText = 'ካርታዬን ያዝ (Get GPS)';
                    alert('ካርታውን ማግኘት አልተቻለም። እባክዎ አድራሻዎን ከታች ይጻፉ።');
                },
                { enableHighAccuracy: true, timeout: 10000 }
            );
        }

        // 7. Booking Submission to Backend API
        async function submitBooking(e) {
            e.preventDefault();
            const btn = document.getElementById('btn-submit-booking');
            btn.disabled = true;
            btn.innerText = 'በመመዝገብ ላይ...';

            const payload = {
                customer_name: document.getElementById('book-name').value,
                customer_phone: document.getElementById('book-phone').value,
                subcity: document.getElementById('book-subcity').value,
                address: document.getElementById('book-address').value + ` (${document.getElementById('book-landmark').value})`,
                latitude: document.getElementById('book-latitude').value ? parseFloat(document.getElementById('book-latitude').value) : null,
                longitude: document.getElementById('book-longitude').value ? parseFloat(document.getElementById('book-longitude').value) : null,
                appointment_date: document.getElementById('book-date').value,
                appointment_time_slot: document.getElementById('book-time-slot').value,
                notes: document.getElementById('book-notes').value || 'በሜሽ ዌብሳይት የተያዘ ቀጠሮ',
                items: [
                    {
                        service_id: selectedSvc === 'carpet' ? 2 : (selectedSvc === 'mattress' ? 3 : (selectedSvc === 'glass' ? 4 : 1)),
                        quantity: wizardQty,
                    }
                ]
            };

            try {
                const res = await fetch('/api/public/book', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    document.getElementById('step-4').classList.add('hidden');
                    document.getElementById('step-success').classList.remove('hidden');
                    document.getElementById('success-booking-id').innerText = data.order_number;
                    lucide.createIcons();
                } else {
                    alert('❌ ስህተት ተፈጥሯል: ' + (data.message || 'ትዕዛዝ መመዝገብ አልተቻለም'));
                }
            } catch (err) {
                alert('❌ የግንኙነት ስህተት: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerText = 'ቀጠሮውን አረጋግጥ (Confirm Booking)';
            }
        }

        function resetWizard() {
            document.getElementById('booking-form').reset();
            document.getElementById('step-success').classList.add('hidden');
            showWizardStep(1);
            selectServiceForBooking('sofa');
        }

        // 8. Live Order Tracking Engine
        async function trackOrder(e) {
            e.preventDefault();
            const q = document.getElementById('track-input').value.trim();
            const resContainer = document.getElementById('track-result');
            resContainer.classList.remove('hidden');
            resContainer.innerHTML = '<p class="text-xs text-cyan-400">የትዕዛዝ ሁኔታ በመፈተሽ ላይ...</p>';

            try {
                const res = await fetch(`/api/public/track-order?query=${encodeURIComponent(q)}`);
                const data = await res.json();
                if (res.ok && data.success) {
                    const ord = data.order;
                    resContainer.innerHTML = `
                        <div class="rounded-2xl bg-slate-900/90 border border-cyan-500/30 p-5">
                            <div class="flex items-center justify-between mb-4">
                                <span class="text-xs font-bold text-slate-400">ትዕዛዝ ቁጥር: <strong class="text-white">${ord.order_number}</strong></span>
                                <span class="px-2.5 py-1 rounded-full text-xs font-black uppercase bg-cyan-950 text-cyan-300 border border-cyan-800">${ord.status}</span>
                            </div>
                            <div class="grid grid-cols-2 gap-3 text-xs mb-4">
                                <div><span class="text-slate-400 block">ደንበኛ:</span> <strong class="text-white">${ord.customer_name}</strong></div>
                                <div><span class="text-slate-400 block">ቀንና ሰዓት:</span> <strong class="text-white">${ord.appointment_date || 'የዛሬ'} (${ord.time_slot || 'ቀን'})</strong></div>
                                <div><span class="text-slate-400 block">የተመደበ ቡድን:</span> <strong class="text-cyan-300">${ord.assigned_team || 'በመመደብ ላይ'}</strong></div>
                                <div><span class="text-slate-400 block">ጠቅላላ ክፍያ:</span> <strong class="text-emerald-400">${ord.total_amount} ብር</strong></div>
                            </div>
                            <div class="pt-3 border-t border-slate-800 text-[11px] text-slate-400">
                                ጥያቄ ካለዎት የሜሽ ሪሴፕሽንን በ <strong>0911000002</strong> ይደውሉ።
                            </div>
                        </div>
                    `;
                } else {
                    resContainer.innerHTML = `<p class="text-xs text-rose-400 font-bold">❌ ${data.message || 'ይህ የትዕዛዝ ቁጥር ወይም ስልክ በሲስተማችን አልተገኘም። እባክዎ እንደገና ያረጋግጡ።'}</p>`;
                }
            } catch (err) {
                resContainer.innerHTML = `<p class="text-xs text-rose-400">ግንኙነት አልተሳካም: ${err.message}</p>`;
            }
        }

        // 9. Real SMS Dispatch Test Engine
        async function dispatchTestSms() {
            const phone = document.getElementById('test-sms-phone').value.trim();
            const message = document.getElementById('test-sms-message').value.trim();
            const btn = document.getElementById('btn-dispatch-test-sms');
            const resultBox = document.getElementById('sms-test-result');

            if (!phone) {
                alert('እባክዎ ስልክ ቁጥር ያስገቡ!');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="animate-spin">⏳</span> በመላክ ላይ...';

            try {
                const res = await fetch('/api/public/sms/test', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ phone, message: message || null })
                });
                const data = await res.json();

                if (res.ok && data.success) {
                    const r = data.result;
                    resultBox.innerHTML = `
                        <div class="space-y-2">
                            <span class="px-2 py-0.5 rounded bg-emerald-950 text-emerald-300 font-bold text-[10px] border border-emerald-800">✅ የተሳካ የሙከራ ሂደት</span>
                            <p class="text-white font-bold">ወደ: ${r.phone}</p>
                            <p class="text-slate-300">ሁኔታ: <span class="text-cyan-300 font-bold">${r.status}</span> (Carrier: ${r.is_live ? 'LIVE CARRIER 📶' : 'SIMULATED / AUDIT LOGGED 📋'})</p>
                            <div class="p-2 rounded bg-black/60 border border-slate-800 text-[10px] text-slate-300 font-mono">
                                ${r.message}
                            </div>
                            <p class="text-[10px] text-cyan-400">${r.provider_response}</p>
                        </div>
                    `;
                } else {
                    resultBox.innerHTML = `<p class="text-rose-400">❌ ስህተት ተፈጥሯል: ${data.message || 'መላክ አልተቻለም'}</p>`;
                }
            } catch (err) {
                resultBox.innerHTML = `<p class="text-rose-400">ግንኙነት አልተሳካም: ${err.message}</p>`;
            } finally {
                btn.disabled = false;
                btn.innerHTML = '📨 የሙከራ ኤስኤምኤስ ወደ ስልኬ ላክ (Send Test SMS)';
                lucide.createIcons();
            }
        }

        // 10. Real Device Push / Local Notifications Engine
        async function requestPushNotification() {
            if (!('Notification' in window)) {
                alert('ይህ ብሮውዘር ማሳወቂያዎችን (Notifications) አይደግፍም።');
                return;
            }
            const perm = await Notification.requestPermission();
            if (perm === 'granted') {
                if ('serviceWorker' in navigator && navigator.serviceWorker.ready) {
                    const reg = await navigator.serviceWorker.ready;
                    reg.showNotification('ሜሽ የፅዳት አገልግሎት | Mesh Cleaning', {
                        body: '✅ ማሳወቂያዎች በተሳካ ሁኔታ ተፈቅደዋል! የትዕዛዝ እና የቀጠሮ ማንቂያዎች ይደርሱዎታል።',
                        icon: '/assets/icon-192.png',
                        badge: '/assets/icon-192.png',
                        vibrate: [200, 100, 200]
                    });
                } else {
                    new Notification('ሜሽ የፅዳት አገልግሎት | Mesh Cleaning', {
                        body: '✅ ማሳወቂያዎች በተሳካ ሁኔታ ተፈቅደዋል!',
                        icon: '/assets/icon-192.png'
                    });
                }
                alert('✅ ማሳወቂያዎች ተፈቅደዋል! የስልክዎ/የኮምፒውተርዎ የስክሪን ማሳወቂያ ደርሶዎታል።');
            } else {
                alert('⚠️ ማሳወቂያዎች አልተፈቀዱም። እባክዎ በብሮውዘር ቅንብር ውስጥ ይፍቀዱ።');
            }
        }

        // 11. PWA Service Worker Registration & Install Prompt Engine
        let deferredPrompt = null;
        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
            const banner = document.getElementById('pwa-install-banner');
            if (banner) banner.classList.remove('hidden');
        });

        async function triggerPwaInstall() {
            if (!deferredPrompt) {
                alert('መተግበሪያው አስቀድሞ ተጭኗል ወይም በብሮውዘርዎ ሜኑ (Menu -> Add to Home Screen) መጫን ይችላሉ።');
                return;
            }
            deferredPrompt.prompt();
            const { outcome } = await deferredPrompt.userChoice;
            console.log(`User response to install prompt: ${outcome}`);
            deferredPrompt = null;
            const banner = document.getElementById('pwa-install-banner');
            if (banner) banner.classList.add('hidden');
        }

        function dismissPwaBanner() {
            const banner = document.getElementById('pwa-install-banner');
            if (banner) banner.classList.add('hidden');
        }

        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').then((reg) => {
                    console.log('Mesh ServiceWorker registered successfully:', reg.scope);
                }).catch((err) => {
                    console.warn('Mesh ServiceWorker registration failed:', err);
                });
            });
        }

        // 12. Bilingual Toggle (አማርኛ / English)
        function toggleLang(lang) {
            const amBtn = document.getElementById('top-btn-am');
            const enBtn = document.getElementById('top-btn-en');
            if (lang === 'am') {
                amBtn.className = 'px-2 py-0.5 rounded font-extrabold text-white bg-cyan-600 transition-all';
                enBtn.className = 'px-2 py-0.5 rounded font-bold text-slate-400 hover:text-white transition-all';
                document.getElementById('nav-svc').innerText = 'አገልግሎቶች';
                document.getElementById('nav-compare').innerText = '3D ውጤት (Before/After)';
                document.getElementById('nav-calc').innerText = 'ዋጋ አስላ';
                document.getElementById('nav-track').innerText = 'ትዕዛዝ ተከታተል';
                document.getElementById('nav-cta-book').innerText = 'ቦታ ያስይዙ';
            } else {
                enBtn.className = 'px-2 py-0.5 rounded font-extrabold text-white bg-cyan-600 transition-all';
                amBtn.className = 'px-2 py-0.5 rounded font-bold text-slate-400 hover:text-white transition-all';
                document.getElementById('nav-svc').innerText = 'Services';
                document.getElementById('nav-compare').innerText = '3D Results';
                document.getElementById('nav-calc').innerText = 'Calculator';
                document.getElementById('nav-track').innerText = 'Track Order';
                document.getElementById('nav-cta-book').innerText = 'Book Now';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            calculatePrice();
        });
    </script>
</body>
</html>
