APP_NAME="Meash Cleaning Solution"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=am
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meash_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# ==========================================
# MEASH SYSTEM INITIAL OWNER CREDENTIALS (SET BEFORE FIRST RUN)
# ==========================================
MEASH_OWNER_NAME="Meash General Manager"
MEASH_OWNER_EMAIL="owner@meash.com"
MEASH_OWNER_PHONE="0911000001"
MEASH_OWNER_PASSWORD=
MEASH_SEED_DEMO_DATA=false

# ==========================================
# TELEGRAM BOT & WEBHOOK CONFIGURATION
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=meash_cleaning_solution_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL="${APP_URL}/api/telegram/webhook"
TELEGRAM_MINIAPP_URL="${APP_URL}/telegram-miniapp"
TELEGRAM_ENFORCE_INITDATA=true

# ==========================================
# DIRECT PHONE SMS & NOTIFICATION CONFIGURATION
# ==========================================
SMS_PROVIDER=direct_phone
SMS_SENDER_ID=Meash

# ==========================================
# SECURITY & SESSION CONFIGURATION
# ==========================================
SANCTUM_STATEFUL_DOMAINS=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
