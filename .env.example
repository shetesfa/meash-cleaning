APP_NAME="Meash Cleaning Solution"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=am
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meash_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# ==========================================
# MEASH SYSTEM INITIAL OWNER CREDENTIALS
# ==========================================
MEASH_OWNER_NAME="Meash General Manager"
MEASH_OWNER_EMAIL="owner@meash.com"
MEASH_OWNER_PHONE="0911000001"
MEASH_OWNER_PASSWORD="change_me_to_a_secure_password"

# ==========================================
# TELEGRAM BOT & WEBHOOK CONFIGURATION
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=meash_cleaning_solution_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram/webhook
TELEGRAM_MINIAPP_URL=https://shetesfa.github.io/meash-mini-app/

# ==========================================
# SMS GATEWAY & AFROMESSAGE CONFIGURATION
# ==========================================
SMS_PROVIDER=afromessage
AFROMESSAGE_TOKEN=
SMS_GATEWAY_URL=https://api.afromessage.com/api/send
SMS_SENDER_ID=Meash
