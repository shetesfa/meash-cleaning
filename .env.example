# ==============================================================================
# MEASH CLEANING SOLUTION — PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# Ethiopian Telecommunication Plesk Hosting / Hardened Production Architecture
# ==============================================================================
#
# PLESK PRODUCTION DEPLOYMENT CHECKLIST:
# 1. Document Root: Point hosting domain Document Root strictly to 'httpdocs/public'.
# 2. PHP Version: Ensure PHP 8.2 or higher is active with extensions:
#    pdo_mysql, mbstring, openssl, curl, json, tokenizer, xml, ctype, fileinfo, bcmath.
# 3. Permissions: Ensure storage/ and bootstrap/cache/ are writable:
#    chmod -R 775 storage bootstrap/cache
# 4. Dependencies: Run 'composer install --no-dev --optimize-autoloader'
# 5. Asset Build: Run 'npm ci && npm run build'
# 6. Database: Run 'php artisan migrate --force' and seed services 'php artisan db:seed --class=ServiceSeeder --force'
# 7. Owner Account: Run 'php artisan meash:provision-owner --username=amha'
# 8. Crontab (Scheduled Tasks): Add '* * * * * cd /path/to/httpdocs && php artisan schedule:run >> /dev/null 2>&1'
# 9. Telegram Webhook: Configure TELEGRAM_BOT_TOKEN and run 'php artisan meash:telegram-webhook --set'
# ==============================================================================

APP_NAME="MEASH CLEANING SOLUTION"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain-placeholder.com

APP_LOCALE=am
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# IMPORTANT: Never use 'root' or empty passwords in production hosting environments.
# Create a dedicated least-privileged MySQL user inside Plesk Database Manager.
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meash_production_db
DB_USERNAME=meash_app_user
DB_PASSWORD="change_me_to_a_strong_database_password_123!"

# ------------------------------------------------------------------------------
# SESSION CONFIGURATION
# Production sessions expire after 120 minutes of inactivity (not 1 year).
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------------------
# QUEUE & CACHE
# NOTE: QUEUE_CONNECTION=sync processes queued tasks (emails, webhooks) synchronously
# within the web request lifecycle. For high-volume asynchronous workers on Plesk,
# switch to 'database' and run 'php artisan queue:work --stop-when-empty' in cron.
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# ------------------------------------------------------------------------------
# INITIAL OWNER CREDENTIALS (USED BY PROVISIONING COMMAND)
# Username is strictly enforced as 'amha'
# ------------------------------------------------------------------------------
MEASH_OWNER_NAME="Amha Owner"
MEASH_OWNER_EMAIL="owner@your-domain-placeholder.com"
MEASH_OWNER_PHONE="0911000001"
MEASH_OWNER_PASSWORD=
MEASH_SEED_DEMO_DATA=false

# ------------------------------------------------------------------------------
# TELEGRAM BOT & MINI APP CONFIGURATION
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=meash_cleaning_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL="${APP_URL}/api/telegram/webhook"
TELEGRAM_MINIAPP_URL="${APP_URL}/telegram-miniapp"
TELEGRAM_ENFORCE_INITDATA=true
TELEGRAM_AUTH_DATE_MAX_AGE=900

# ------------------------------------------------------------------------------
# DIRECT PHONE SMS CONFIGURATION
# ------------------------------------------------------------------------------
SMS_PROVIDER=direct_phone
SMS_SENDER_ID=Meash
SANCTUM_STATEFUL_DOMAINS=
